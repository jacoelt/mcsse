# Local virtualenv — built for Windows, useless (and huge) inside the image.
venv/

# Local dev database (~100 MB) and generated static assets.
db.sqlite3
staticfiles/

# Secrets stay out of the image; compose injects env vars instead.
.env
.env.*
!.env.dist

# Test/coverage artifacts
.coverage
htmlcov/
.pytest_cache/

# Python bytecode
__pycache__/
*.py[cod]

# Tooling noise
.claude/
*.stackdump
